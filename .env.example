# Which Gemma 4 backend to use: local (Ollama) or aistudio (Google AI Studio / Gemini API backup)
ARDHAM_BACKEND=local

# Local backend (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# AI Studio backup backend — only needed if ARDHAM_BACKEND=aistudio
GOOGLE_API_KEY=
AISTUDIO_MODEL=gemma-4-27b-it

# Frontend -> backend URL (set in frontend/.env as VITE_API_BASE)
VITE_API_BASE=http://localhost:8000
