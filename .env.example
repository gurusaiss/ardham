# Which backend to use: local (Ollama) | aistudio (Google AI Studio Gemma) | groq (Fast Cloud) | stub
ARDHAM_BACKEND=local

# 1. Local backend (Ollama) — Best for on-device offline demo
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# 2. Google AI Studio backend — Required for "Best Use of Gemma 4" cloud demo / backup
GOOGLE_API_KEY=
AISTUDIO_MODEL=gemini-2.5-flash

# 3. Groq backend — Ultra-fast cloud inference for open-source track
GROQ_API_KEY=
GROQ_MODEL=llama-3.2-11b-vision-preview

# Frontend -> backend URL (set in frontend/.env as VITE_API_BASE)
VITE_API_BASE=http://localhost:8000
